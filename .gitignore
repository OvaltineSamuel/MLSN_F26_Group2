# ---- Data (large / regenerated — not version-controlled) ----
data/raw/*
data/processed/*
!data/**/.gitkeep

# ---- Model + results artifacts (regenerated by the notebooks) ----
models/*
results/*
!models/.gitkeep
!results/.gitkeep
# Re-include the figures folder (can't re-add a file inside an excluded dir)
!results/figures/
results/figures/*
!results/figures/.gitkeep

# ---- Paper PDF (copyrighted Nature content; keep local only) ----
docs/paper/*.pdf

# ---- Local backup of the original notebooks ----
archive/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Claude Code local settings ----
.claude/settings.local.json
